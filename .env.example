# ==============================================================================
# MÉTODO OFICIAL ÚNICO — CONFIGURAÇÃO PÚBLICA + SECRETS (CLOUDFLARE WORKER)
# ==============================================================================
# No Cloudflare Worker (porttohubpro -> Settings -> Variables and Secrets):
#   1) Cadastre SUPABASE_URL e SUPABASE_PUBLISHABLE_KEY (ou SUPABASE_ANON_KEY) como variáveis Text (públicas).
#      O Worker entrega esses valores automaticamente ao navegador em runtime via /env-config.js
#      e também os utiliza nas rotas /api/*.
#   2) Em desenvolvimento local ou build Vite estático, você também pode definir
#      VITE_SUPABASE_URL e VITE_SUPABASE_ANON_KEY com os mesmos valores públicos.
# NUNCA coloque service_role, SUPABASE_SECRET_KEY, tokens do Redis ou chaves de IA em variáveis VITE_.
# ==============================================================================
SUPABASE_URL="https://SEU_PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_ANON_KEY="SUA_CHAVE_ANON_PUBLICA"

# Opcionais para build local/Vite (em produção no Cloudflare Worker, /env-config.js já supre)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ==============================================================================
# SECRETS PRIVADOS (Cadastrar como Secret / Criptografado no Cloudflare Worker)
# ==============================================================================
SUPABASE_SERVICE_ROLE_KEY=""

# Upstash Redis REST (Compatível com Node.js e Cloudflare Workers)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Gemini API Key (usada exclusivamente no backend para OCR de etiquetas de pacotes)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_OCR_MODEL="gemini-4-hydrogen"

# Opcional: token read-only para /api/github-versao e URL pública da aplicação
GITHUB_TOKEN=""
APP_URL="MY_APP_URL"
